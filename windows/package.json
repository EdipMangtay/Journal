{
  "name": "liquidity-edge-windows",
  "productName": "Liquidity Edge",
  "version": "1.1.0",
  "description": "Offline trading journal for Windows",
  "author": "Edip Mangtay",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "heic-decode": "2.1.0",
    "lucide": "1.49.0",
    "papaparse": "5.7.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.liquidityedge.journal.windows",
    "productName": "Liquidity Edge",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signExts": [".exe", ".dll", ".node"],
      "artifactName": "Liquidity-Edge-Windows-Setup.exe"
    },
    "nsis": {
      "language": "1055",
      "installerLanguages": ["tr_TR"],
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
